#include <windows.h>

// Embedded version + identity information for the ArctixI programs.
// GENERATED by CMake from resources/arctixi.rc.in - do not edit the
// generated copies. FILEVERSION/PRODUCTVERSION track project VERSION
// in ArctixI/CMakeLists.txt automatically.

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @ARCTIXI_VERSION_MAJOR@,@ARCTIXI_VERSION_MINOR@,@ARCTIXI_VERSION_PATCH@,0
 PRODUCTVERSION @ARCTIXI_VERSION_MAJOR@,@ARCTIXI_VERSION_MINOR@,@ARCTIXI_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Whitepoint Software Development"
            VALUE "FileDescription", "@ARCTIXI_FILE_DESCRIPTION@"
            VALUE "FileVersion", "@ARCTIXI_VERSION@.0"
            VALUE "InternalName", "@ARCTIXI_INTERNAL_NAME@"
            VALUE "OriginalFilename", "@ARCTIXI_ORIGINAL_FILENAME@"
            VALUE "ProductName", "@ARCTIXI_ORIGINAL_FILENAME@"
            VALUE "ProductVersion", "@ARCTIXI_VERSION@.0"
            VALUE "LegalCopyright", "Copyright (c) 2026 Whitepoint Software Development (Yummyzzzz) - Arctix"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

// The setup wizard carries LICENSE.md inside itself (RCDATA), so the
// license page always has the text even when the exe is copied alone.
// Expanded by CMake for the setup exe only; empty for the other programs.
@ARCTIXI_EMBED_LICENSE@
