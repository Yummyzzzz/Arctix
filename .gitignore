# CMake build trees (regenerate with each component's build.ps1)
build/
out/

# Local packages in Arctix root (never commit)
/pckgs/

# Website in Arctix root (never commit)
/website/

# Shippable setup folder assembled by ArctixI/build.ps1
dist/

# MSVC / CMake byproducts that can leak outside build trees
*.ilk
*.pdb
*.user
.vs/

# Local helper: auto-commit + push script in repo root (never commit it)
autopush.ps1
