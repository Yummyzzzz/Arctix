#pragma once

// ArctixC foundation - version information.
// Types + function declarations. Implementation in src/core/version.cpp.
//
// NOTE: this file is GENERATED by CMake from version.hpp.in - do not edit
// the generated copy. The single source of truth is the project VERSION
// in ArctixC/CMakeLists.txt; both the macros below and the arctixc.dll
// VERSIONINFO resource update automatically from it.
//
// The ARCTIX_* macros are kept as aliases so code written against
// Arctix Core v0.1.0 keeps compiling against the new header layout.

#define ARCTIXC_VERSION_MAJOR @ArctixC_VERSION_MAJOR@
#define ARCTIXC_VERSION_MINOR @ArctixC_VERSION_MINOR@
#define ARCTIXC_VERSION_PATCH @ArctixC_VERSION_PATCH@

#define ARCTIXC_VERSION_STRING "@ArctixC_VERSION@"
#define ARCTIXC_VERSION_NAME "ArctixC"

// Backwards-compatible aliases for the v0.1.0 header layout.
#define ARCTIX_VERSION_MAJOR ARCTIXC_VERSION_MAJOR
#define ARCTIX_VERSION_MINOR ARCTIXC_VERSION_MINOR
#define ARCTIX_VERSION_PATCH ARCTIXC_VERSION_PATCH
#define ARCTIX_VERSION_STRING ARCTIXC_VERSION_STRING
#define ARCTIX_VERSION_NAME ARCTIXC_VERSION_NAME

#include "arctixc/core/export.hpp"

#ifdef __cplusplus
extern "C"
{
#endif

// Returns e.g. "0.1.1". Never returns NULL.
ARCTIXC_CORE_API const char* ArctixC_GetVersionString(void);

// Writes major/minor/patch into the non-NULL out parameters.
// NULL parameters are ignored.
ARCTIXC_CORE_API void ArctixC_GetVersion(int* major, int* minor, int* patch);

#ifdef __cplusplus
} // extern "C"

namespace arctixs
{
namespace Core
{

// C++ wrappers for the C ABI above, so every version query reads
// arctixs::Core::<func>. Header-only: they forward to the DLL exports.
inline const char* GetVersionString() { return ::ArctixC_GetVersionString(); }
inline void GetVersion(int* major, int* minor, int* patch) { ::ArctixC_GetVersion(major, minor, patch); }
inline int GetVersionMajor() { int m = 0; ::ArctixC_GetVersion(&m, nullptr, nullptr); return m; }
inline int GetVersionMinor() { int m = 0; ::ArctixC_GetVersion(nullptr, &m, nullptr); return m; }
inline int GetVersionPatch() { int p = 0; ::ArctixC_GetVersion(nullptr, nullptr, &p); return p; }

} // namespace Core
} // namespace arctixs

#endif
