#include <windows.h>

// Embedded version + identity information for arctixc.dll.
// GENERATED by CMake from resources/arctixc.rc.in - do not edit the
// generated copy. FILEVERSION/PRODUCTVERSION track the project VERSION
// in ArctixC/CMakeLists.txt automatically.

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @ArctixC_VERSION_MAJOR@,@ArctixC_VERSION_MINOR@,@ArctixC_VERSION_PATCH@,0
 PRODUCTVERSION @ArctixC_VERSION_MAJOR@,@ArctixC_VERSION_MINOR@,@ArctixC_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x2L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Whitepoint Software Development"
            VALUE "FileDescription", "ArctixC systems SDK (memory, buffers, virtual memory, threads)"
            VALUE "FileVersion", "@ArctixC_VERSION@.0"
            VALUE "InternalName", "arctixc"
            VALUE "OriginalFilename", "arctixc.dll"
            VALUE "ProductName", "arctixc.dll"
            VALUE "ProductVersion", "@ArctixC_VERSION@.0"
            VALUE "LegalCopyright", "Copyright (c) 2026 Whitepoint Software Development (Yummyzzzz) - Arctix"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
